{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Key": "CHANGE_ME_JWT_SECRET_MINIMUM_32_CHARACTERS",
    "Issuer": "FinOS",
    "Audience": "FinOS Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/users/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "corefinance-route": {
        "ClusterId": "corefinance-cluster",
        "Match": { "Path": "/api/corefinance/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "budget-route": {
        "ClusterId": "budget-cluster",
        "Match": { "Path": "/api/budget/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "investment-route": {
        "ClusterId": "investment-cluster",
        "Match": { "Path": "/api/investment/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "loan-route": {
        "ClusterId": "loan-cluster",
        "Match": { "Path": "/api/loan/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "goals-route": {
        "ClusterId": "goals-cluster",
        "Match": { "Path": "/api/goals/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/analytics/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "aiassistant-route": {
        "ClusterId": "aiassistant-cluster",
        "Match": { "Path": "/api/aiassistant/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5001" } }
      },
      "corefinance-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5002" } }
      },
      "budget-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5003" } }
      },
      "investment-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5004" } }
      },
      "loan-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5005" } }
      },
      "goals-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5006" } }
      },
      "analytics-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5007" } }
      },
      "aiassistant-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5008" } }
      },
      "notification-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5009" } }
      }
    }
  },
  "AllowedHosts": "*"
}
